{
  "name": "rv-trip",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @rv-trip/db generate",
    "db:migrate": "pnpm --filter @rv-trip/db migrate",
    "db:push": "pnpm --filter @rv-trip/db push",
    "db:studio": "pnpm --filter @rv-trip/db studio",
    "db:seed": "pnpm --filter @rv-trip/db seed"
  },
  "devDependencies": {
    "turbo": "^2.5.5",
    "typescript": "^5.9.3"
  }
}
