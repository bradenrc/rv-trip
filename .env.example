# Local Postgres (docker compose). Host port 5433 avoids clashing with a system Postgres on 5432.
DATABASE_URL="postgres://rvtrip:rvtrip@localhost:5433/rvtrip"

# --- Deferred for local-dev-first; wire when moving toward the cloud target ---
# Auth (Clerk) — local dev uses a stub user, so these are optional locally.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
# CLERK_SECRET_KEY=""

# Maps — provider interfaces are stubbed locally; add real keys for live routing/places.
# Routing = HERE (RV-safe truck routing, #9) · Places = Google · Display = Mapbox GL.
# Secret keys are server-side ONLY — never NEXT_PUBLIC_*. The one deliberate
# exception is Mapbox's publishable pk.* token (tile rendering only, domain-restricted).
GOOGLE_API_KEY=""                  # Google Places (search/details/reviews).
                                   # Server-side ONLY. Empty/absent = local dev:
                                   # googleCredentialsFromEnv() returns null and
                                   # StubPlacesProvider answers, so search degrades
                                   # to the free-text row rather than erroring.
# HERE auth is OAuth 2.0 client credentials (this org's REST API keys never
# activate — verified 2026-09-07). Values come from the app's downloaded
# credentials.properties; token grant is signed (HMAC-SHA256), cached ~24h.
# HERE_ACCESS_KEY_ID=""            # here.access.key.id
# HERE_ACCESS_KEY_SECRET=""        # here.access.key.secret
# HERE_TOKEN_ENDPOINT=""           # here.token.endpoint.url
NEXT_PUBLIC_MAPBOX_TOKEN=""        # Mapbox GL publishable pk.* token (map display).
                                   # Without it every map degrades to the "Map
                                   # unavailable" frame; the rest of the page works.
