{
  "expo": {
    "name": "RV Trip Hub",
    "slug": "rv-trip-hub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bradenrc.rvtriphub"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.bradenrc.rvtriphub"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "rvtrip",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "@rnmapbox/maps",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "RV Trip Hub uses your location to drop a pin, or to file a note under the town you're in."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
